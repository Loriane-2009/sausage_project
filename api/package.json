{
  "name": "express-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node src/server.js",
    "test": "node --env-file=.env.test --test --test-concurrency=1 --experimental-test-coverage --test-coverage-exclude=tests/** --test-coverage-lines=75",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "seed": "node --env-file-if-exists=.env src/seed.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "express": "^5.2.1",
    "http-errors": "^2.0.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.2",
    "morgan": "^1.12.1"
  },
  "engines": {
    "node": "^22.9 || ^24 || ^26"
  },
  "devDependencies": {
    "prettier": "3.10.1",
    "supertest": "^7.3.2"
  }
}
